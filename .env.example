# 复制为 .env 后按需修改。.env 已被 .gitignore 排除，不要提交真实密码。
# docker compose 会自动读取同目录下的 .env，并把值注入容器。

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=root
MYSQL_DB=demo_db
MYSQL_USER=demo
MYSQL_PASSWORD=demo
MYSQL_PORT=3306

# ---- Redis ----
REDIS_PORT=6379

# ---- Kafka ----
# 宿主机访问用 29092；容器内部用 9092。
KAFKA_HOST_PORT=29092

# ---- 应用连接宿主机映射端口时使用 ----
MYSQL_HOST=localhost
REDIS_HOST=localhost
KAFKA_BOOTSTRAP=localhost:29092
REDIS_DB=0
REDIS_PASSWORD=
