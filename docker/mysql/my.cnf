# Canal 依赖的 MySQL 配置：ROW 格式 + FULL 行镜像，否则拿不到完整行数据。
[mysqld]
server-id=1
log-bin=mysql-bin
binlog-format=ROW
binlog-row-image=FULL
binlog-expire-logs-seconds=604800

# 保证 binlog 位点在重启后连续，避免 Canal 解析到不存在的文件。
max-binlog-size=512M
sync-binlog=1

character-set-server=utf8mb4
collation-server=utf8mb4_unicode_ci
